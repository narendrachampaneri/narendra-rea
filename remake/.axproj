package_name=com.narendra.minimilitia
engine_version=2.11.5
project_type=cpp
min_sdk=35
target_sdk=36
# 16 KB page-aligned native libraries need NDK r27 or newer
ndk=r27c
# Exact CMake used by CI and Android Studio (SDK Manager > SDK Tools > CMake 3.31.6).
# No trailing '+': Axmol then skips newer installed CMakes (e.g. 4.1.2) and uses exactly this one.
cmake=3.31.6
