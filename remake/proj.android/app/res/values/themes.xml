<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme: the system splash (app icon on the title screen's night-sky colour) shows
         while the native game starts, then the game's own title screen takes over. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">#2B2247</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
